# AWS RDS PostgreSQL
POSTGRES_USER=your_rds_username
POSTGRES_PASSWORD=your_rds_password
POSTGRES_DB=your_rds_database
POSTGRES_HOST=your-db.xxxxx.ap-south-1.rds.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRE_DAYS=7

# Website (used in emails)
APP_NAME=AI Outbound Sales
# Base app URL. Email links use role-specific paths:
# /admin/login, /manager/login, /agent/login
# IMPORTANT: use your public HTTPS URL in production (not localhost).
APP_URL=https://your-domain.com/admin/login

# Email (SMTP)
# 1. EMAIL_USER and EMAIL_FROM must use the SAME address (Gmail/Workspace authenticates EMAIL_USER)
# 2. Use a Gmail App Password — never your normal account password
# 3. Set APP_URL to your public HTTPS domain (not localhost) before production emails
# 4. For production: use Google Workspace or SendGrid/SES with your own domain + SPF/DKIM/DMARC
# 5. Keep EMAIL_REPLY_TO set to a monitored inbox
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM="AI Outbound Sales <your-email@gmail.com>"
EMAIL_REPLY_TO=your-email@gmail.com
EMAIL_USE_TLS=true

# Twilio + OpenAI (outbound AI agent calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Country code added to 10-digit lead numbers without + prefix (change anytime).
PHONE_COUNTRY_CODE=91
# Public HTTPS URL Twilio can reach (local dev: run `ngrok http 8000` and paste the URL here).
TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-or-domain.com
# Human browser calling (optional — auto-created from TWILIO_ACCOUNT_SID + TWILIO_AUTH_TOKEN on first use)
# TwiML App Voice URL: {TWILIO_WEBHOOK_BASE_URL}/api/webhooks/twilio/voice/client-outbound (POST)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=

# Production API server (multi-agent calls) — use Gunicorn instead of `python app.py`
# WEB_CONCURRENCY=4
# GUNICORN_THREADS=4
# GUNICORN_BIND=0.0.0.0:8000
OPENAI_API_KEY=

# Human call recordings (optional — Twilio recording is archived to S3 after each browser call)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=ap-south-1
S3_RECORDINGS_PREFIX=human-call-recordings
